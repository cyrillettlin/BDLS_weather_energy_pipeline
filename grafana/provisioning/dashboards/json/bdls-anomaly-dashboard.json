    {
      "title": "Übersicht: Alle Anlagen (letzte Werte)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT 'wind' AS type, windpark_id AS anlage, time, deviation_rpm AS deviation FROM windpark_estimates WHERE (windpark_id, time) IN (SELECT windpark_id, MAX(time) FROM windpark_estimates GROUP BY windpark_id) UNION ALL SELECT 'pv' AS type, station_id AS anlage, time, deviation_w AS deviation FROM pv_estimates WHERE (station_id, time) IN (SELECT station_id, MAX(time) FROM pv_estimates GROUP BY station_id) ORDER BY type, anlage",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "displayMode": "color-background" },
          "thresholds": {
