  "panels": [
    {
      "title": "Windpark",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Windpark ${windpark}: Actual vs. Erwarteter RPM-Bereich",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 1 },
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT time AS \"time\", actual_rpm, expected_rpm_min, expected_rpm_max, wind_speed FROM windpark_estimates WHERE windpark_id = '$windpark' AND $__timeFilter(time) ORDER BY time",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "rotrpm" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "expected_rpm_min" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "expected_rpm_max" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "actual_rpm" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "wind_speed" },
            "properties": [{ "id": "unit", "value": "velocityms" }]
          }
        ]
      }
    },
    {
      "title": "Windpark ${windpark}: Aktuelle Abweichung (RPM)",
      "type": "gauge",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT deviation_rpm FROM windpark_estimates WHERE windpark_id = '$windpark' ORDER BY time DESC LIMIT 1",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rotrpm",
          "min": -30,
          "max": 30,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": -6 },
              { "color": "red", "value": -10 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
